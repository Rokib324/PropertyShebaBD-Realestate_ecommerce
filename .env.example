# MongoDB Connection String (Required)
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/propertyshebabd?retryWrites=true&w=majority
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/propertyshebabd
MONGODB_URI=

# ── NextAuth (Required) ──────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Super Admin Gmail ───────────────────────────────────────────
SUPER_ADMIN_EMAIL=rakib4458@gmail.com

# ── Google OAuth (Required for Super Admin login) ────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Contact Information
NEXT_PUBLIC_CONTACT_PHONE=+8801704861100

# Server Port
PORT=3000
